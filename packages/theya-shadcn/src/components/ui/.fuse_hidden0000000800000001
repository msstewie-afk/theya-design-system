// Custom kebab glyphs — iconoir's MoreVert/MoreHoriz read as too thin/small
// even at the darkest available text token (--color-text-text). Drawn as
// three bold circles instead of relying on an icon font's stroke weight, so
// size and contrast stay fully in our control.
//
// Use these ONLY where the icon is a kebab/overflow-menu trigger (a real
// interactive button). Non-interactive ellipsis indicators (pagination,
// breadcrumb truncation) are unaffected by this exception.

export interface KebabIconProps {
  className?: string;
}

export function KebabIconVertical({ className }: KebabIconProps) {
  return (
    <svg
      viewBox="0 0 24 24"
      width="1em"
      height="1em"
      className={className}
      fill="currentColor"
      aria-hidden="true"
    >
      <circle cx="12" cy="5" r="2.25" />
      <circle cx="12" cy="12" r="2.25" />
      <circle cx="12" cy="19" r="2.25" />
    </svg>
  );
}

export function KebabIconHorizontal({ className }: KebabIconProps) {
  return (
    <svg
      viewBox="0 0 24 24"
      width="1em"
      height="1em"
      className={className}
      fill="currentColor"
      aria-hidden="true"
    >
      <circle cx="5" cy="12" r="2.25" />
      <circle cx="12" cy="12" r="2.25" />
      <circle cx="19" cy="12" r="2.25" />
    </svg>
  );
}
