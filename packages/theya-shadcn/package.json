{
  "name": "@theya/shadcn",
  "version": "0.1.0",
  "private": true,
  "description": "Theya design system, rebuilt on shadcn/ui (Radix + Tailwind v4)",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./ui/*": "./src/components/ui/*.tsx",
    "./ui/text-field-variants": "./src/components/ui/text-field-variants.ts",
    "./ui/use-media-query": "./src/components/ui/use-media-query.ts",
    "./ui/use-theme": "./src/components/ui/use-theme.ts",
    "./ui/use-density": "./src/components/ui/use-density.ts",
    "./blocks/*": "./src/components/blocks/*.tsx",
    "./blocks/catalog/types": "./src/components/blocks/catalog/types.ts",
    "./blocks/catalog/demo-data": "./src/components/blocks/catalog/demo-data.ts",
    "./blocks/commerce/demo-data": "./src/components/blocks/commerce/demo-data.ts",
    "./blocks/search/types": "./src/components/blocks/search/types.ts",
    "./blocks/search/demo-data": "./src/components/blocks/search/demo-data.ts",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "storybook": "pnpm --filter @theya/tokens build && storybook dev -p 6008",
    "build-storybook": "pnpm --filter @theya/tokens build && storybook build",
    "test-storybook": "test-storybook --url http://localhost:6008",
    "test-storybook:dark": "THEYA_THEME=dark test-storybook --url http://localhost:6008",
    "test-visual": "THEYA_VISUAL=1 test-storybook --url http://localhost:6008",
    "test-visual:dark": "THEYA_VISUAL=1 THEYA_THEME=dark test-storybook --url http://localhost:6008",
    "test-visual:forced": "THEYA_VISUAL=1 THEYA_FORCED=1 test-storybook --url http://localhost:6008",
    "spec": "node scripts/build-spec.mjs",
    "spec:check": "node scripts/build-spec.mjs --check",
    "api": "node scripts/build-spec.mjs && node scripts/build-api.mjs && node scripts/build-a11y.mjs",
    "a11y": "node scripts/build-spec.mjs && node scripts/build-a11y.mjs",
    "a11y:auto": "node scripts/a11y-auto.mjs --url http://localhost:6008 && node scripts/build-a11y.mjs",
    "api:check": "node scripts/build-spec.mjs --check && node scripts/build-api.mjs --check && node scripts/build-a11y.mjs --check && node scripts/check-client.mjs && node scripts/check-rtl.mjs",
    "figma:docs": "node scripts/figma-docs.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
