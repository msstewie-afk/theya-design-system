    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/fira-code": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@lezer/highlight": "^1.2.3",
    "@radix-ui/react-accordion": "^1.2.20",
