{
  "$comment": "Generated by scripts/build-spec.mjs from the component sources — do not edit by hand.",
  "name": "Meter",
  "file": "ui/meter",
  "import": "import { Meter } from '@theya/shadcn/ui/meter';",
  "status": "stable",
  "category": "Status & Feedback",
  "whenToUse": [
    "How full something is within a known range: disk, memory, a quota, seats used.",
    "A score or level, also as segments (`segments`)."
  ],
  "whenNotToUse": [
    {
      "text": "How far along a running task is",
      "instead": "Progress"
    },
    {
      "text": "A total split into parts",
      "instead": "UsageBar"
    },
    {
      "text": "A value people set",
      "instead": "Slider"
    }
  ],
  "anatomy": [
    {
      "part": "Label",
      "description": "what is measured."
    },
    {
      "part": "Value",
      "description": "formatted with `format` (percent, GB…); hide with `showValue={false}` only if the label says it.",
      "optional": true
    },
    {
      "part": "Bar",
      "description": "fill by `value` between `min` and `max`; `tone` from how critical the level is."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Tone follows the level, and the number says it too.",
        "example": "<div className=\"flex w-72 flex-col gap-3\">\n  <Meter value={0.38} min={0} max={1} label=\"CPU\" tone=\"success\" format={{ style: 'percent' }} />\n  <Meter value={0.96} min={0} max={1} label=\"Disk\" tone=\"danger\" format={{ style: 'percent' }} />\n</div>"
      },
      "dont": {
        "caption": "Progress for a fill level reads as “almost done”, not “almost full”.",
        "example": "<div className=\"flex w-72 flex-col gap-1\">\n  <span className=\"text-body-s\">Disk</span>\n  <Progress value={96} aria-label=\"Disk\" />\n</div>"
      }
    }
  ],
  "a11y": [
    "Native `role=\"meter\"` with min / max / now. Use `getValueLabel` for words where they help (“Nearly full”).",
    "Without a visible `label`, pass `aria-label`.",
    "The tone isn’t the only signal — the value or label must say the level.",
    "For percent pass a fraction with `max={1}`; the component warns about 0.38 of 100."
  ],
  "components": [
    {
      "name": "Meter",
      "props": [
        {
          "name": "value",
          "type": "number",
          "required": true
        },
        {
          "name": "format",
          "type": "NumberFormatOptions",
          "required": false
        },
        {
          "name": "getValueLabel",
          "type": "((formattedValue: string, value: number) => string)",
          "required": false,
          "description": "Custom accessible value text (aria-valuetext), e.g. (f, v) => v >= 90 ? \"Nearly full\" : f."
        },
        {
          "name": "label",
          "type": "ReactNode",
          "required": false
        },
        {
          "name": "max",
          "type": "number",
          "required": false,
          "default": "100"
        },
        {
          "name": "min",
          "type": "number",
          "required": false,
          "default": "0"
        },
        {
          "name": "segments",
          "type": "number",
          "required": false,
          "description": "Render as `segments` discrete lit-or-not cells instead of a smooth\nfill — for a fixed count of physical/logical units (GPUs, seats,\nslots). Typically set `max` equal to `segments` so `value` maps\ndirectly to a count of lit cells."
        },
        {
          "name": "showValue",
          "type": "boolean",
          "required": false,
          "default": "true"
        },
        {
          "name": "tone",
          "type": "MeterTone",
          "values": [
            "info",
            "success",
            "warning",
            "danger",
            "primary"
          ],
          "required": false,
          "default": "primary"
        }
      ]
    }
  ],
  "inherits": [
    "HTMLAttributes"
  ],
