  "whenToUse": [
    "Selectable or removable values: quick filters (“Critical”, “Mine”), selected tags, suggestions."
  ],
  "whenNotToUse": [
    {
      "text": "A read-only status or count",
      "instead": "Badge"
    },
    {
      "text": "Choosing one of several views",
      "instead": "ToggleGroup or Tabs"
    },
    {
      "text": "Actions",
      "instead": "Button"
    }
  ],
  "anatomy": [
    {
      "part": "Pill",
      "description": "a real button stretched over it; `pressed` / `onPressedChange`."
    },
    {
      "part": "Icon",
      "description": "leading.",
      "optional": true
    },
    {
      "part": "Remove",
      "description": "`ChipRemove` — a sibling button, not nested.",
      "optional": true
    },
    {
      "part": "Look",
      "description": "`tone`, `appearance` tonal/filled, `size` sm/md/lg."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Quick filters people toggle on and off.",
        "example": "<div className=\"flex gap-2\">\n  <Chip defaultPressed>Critical</Chip>\n  <Chip>Mine</Chip>\n  <Chip>Unassigned</Chip>\n</div>"
      },
      "dont": {
        "caption": "A status that can’t be clicked styled as a chip — use a Badge.",
        "example": "<div className=\"flex items-center gap-2 font-body text-body-m text-[var(--color-text-text)]\">\n  shop.seashell.dev\n  <Chip tone=\"success\" interactive={false}>Running</Chip>\n</div>"
      }
    },
    {
      "do": {
        "caption": "Read-only state is a Badge.",
        "example": "<div className=\"flex items-center gap-2 font-body text-body-m text-[var(--color-text-text)]\">\n  shop.seashell.dev\n  <Badge tone=\"success\">Running</Badge>\n</div>"
      },
      "dont": {
        "caption": "Chips for an either-or view: both end up selected — use ToggleGroup.",
        "example": "<div className=\"flex gap-2\">\n  <Chip defaultPressed>List</Chip>\n  <Chip defaultPressed>Grid</Chip>\n</div>"
      }
    }
  ],
  "a11y": [
    "Toggle chips are buttons with `aria-pressed`; Space/Enter toggles.",
    "Remove buttons are named per chip (“Remove Critical”).",
    "For selection that must read without color, use `appearance=\"filled\"` — selected filled chips also show a check."
  ],
