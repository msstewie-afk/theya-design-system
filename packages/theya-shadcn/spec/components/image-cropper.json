  "anatomy": [
    {
      "part": "Frame",
      "description": "fixed and centered; the image moves under it and always covers it."
    },
    {
      "part": "Grid",
      "description": "`grid`: always, while interacting, or never.",
      "optional": true
    },
    {
      "part": "Controls",
      "description": "zoom slider and rotate (`controls`, `rotatable`).",
      "optional": true
    },
    {
      "part": "Output",
      "description": "`onCropChange` + `getCroppedImage()` → a Blob to upload."
    }
  ],
  "doDont": [
