  "anatomy": [
    {
      "part": "Input",
      "description": "free text searches; focusing it lists the attributes."
    },
    {
      "part": "Step two",
      "description": "the chosen attribute’s editor: options, text with operator, date or number range."
    },
    {
      "part": "Chips",
      "description": "one per applied filter; click to edit, × to remove."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Five attributes and search in one field; what’s applied is visible as chips.",
        "example": "<div className=\"w-96 max-w-full\">\n  <FilterField attributes={ATTRS} defaultValue={[{ key: 'status', value: 'active' }]} aria-label=\"Filter servers\" />\n</div>"
      },
      "dont": {
        "caption": "A trigger per attribute: the bar wraps, and names and dates get squeezed into checkboxes.",
        "example": "<div className=\"flex w-96 max-w-full flex-wrap gap-2\">\n  <Filter label=\"Name\" options={opts(['web-01', 'web-02'])} />\n  <Filter label=\"Status\" options={opts(['Active', 'Suspended'])} />\n  <Filter label=\"Region\" options={opts(['Europe', 'Americas'])} />\n  <Filter label=\"Created\" options={opts(['Today', 'This week'])} />\n  <Filter label=\"CPU cores\" options={opts(['2', '4'])} />\n</div>"
      }
    }
  ],
