    {
      "text": "A trend people need to read",
      "instead": "Sparkline or LineChart"
    },
    {
      "text": "A fill level",
      "instead": "Meter"
    }
  ],
  "anatomy": [
    {
      "part": "Label",
      "description": "what is counted."
    },
    {
      "part": "Value",
      "description": "big, tabular numbers."
    },
    {
      "part": "Status",
      "description": "dot or `toneIcon` with a word for screen readers (`tone`, `toneLabel`).",
      "optional": true
    },
    {
      "part": "Icon",
      "description": "top-right, decorative.",
      "optional": true
    },
    {
      "part": "Delta",
      "description": "change with direction (`delta`).",
      "optional": true
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "A number, and how it changed against what.",
        "example": "<div className=\"w-56\"><Stat label=\"Active sites\" value={128} icon={<Globe />} delta={{ value: '+12% vs last month', direction: 'up' }} /></div>"
      },
      "dont": {
        "caption": "A sentence in the value slot: nothing to read at a glance.",
        "example": "<div className=\"w-56\"><Stat label=\"Sites\" value=\"128 active, 4 suspended, 2 with errors\" /></div>"
      }
    },
    {
      "do": {
        "caption": "Tone when the value itself is good or bad.",
        "example": "<div className=\"w-56\"><Stat label=\"Uptime, 30 days\" value=\"99.98%\" tone=\"success\" /></div>"
      },
      "dont": {
        "caption": "Danger on a neutral count makes people look for a problem.",
        "example": "<div className=\"w-56\"><Stat label=\"Team members\" value={14} tone=\"danger\" /></div>"
      }
    }
  ],
  "a11y": [
    "A named group; the tone is announced as a word (“healthy”, “critical”), not color.",
    "Delta direction is in the text too (“+12%”); the arrow is decorative.",
    "Inside a Card use `variant=\"plain\"` — one border, not two."
