{
  "$comment": "Generated by scripts/build-spec.mjs from the component sources — do not edit by hand.",
  "name": "Terminal",
  "file": "ui/terminal",
  "import": "import { Terminal, TerminalHeader, TerminalBody, TerminalLine } from '@theya/shadcn/ui/terminal';",
  "status": "beta",
  "category": "Code",
  "whenToUse": [
    "Live or past console output: a web SSH session, a deploy or build log, a tail of access logs.",
    "Output where the order and severity of lines matter."
  ],
  "whenNotToUse": [
    {
      "text": "A command for the user to copy",
      "instead": "CodeBlock"
    },
    {
      "text": "A list of events people browse or filter",
      "instead": "Timeline or DataTable"
    },
    {
      "text": "Editable code",
      "instead": "CodeEditor"
    }
  ],
  "anatomy": [
    {
      "part": "Header",
      "description": "connection dot + label, `user@host`, status text and a `tools` slot.",
      "optional": true
    },
    {
      "part": "Body",
      "description": "scrollback log; follows new lines only while the reader is at the bottom."
    },
    {
      "part": "Line",
      "description": "one line of output; `level` sets the color (cmd, success, warning, error, muted)."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Levels color the lines, and the text itself says “warning” / “error”.",
        "example": "<div className=\"w-80\">\n  <Terminal hideHeader lines={[\n    { id: '1', text: '$ npm run build', level: 'cmd' },\n    { id: '2', text: 'warning: 2 unused exports', level: 'warning' },\n    { id: '3', text: 'error: build failed (exit 1)', level: 'error' },\n  ]} />\n</div>"
      },
      "dont": {
        "caption": "A static code block for a log: no severity, no following new output.",
        "example": "<div className=\"w-80\"><CodeBlock language=\"bash\" code={'$ npm run build\\nwarning: 2 unused exports\\nerror: build failed (exit 1)'} /></div>"
      }
    }
  ],
  "a11y": [
    "The body is `role=\"log\"` and a tab stop; new lines are announced politely. For chatty streams set `live=\"off\"` and announce only the result.",
    "Connection state is a dot plus a text label, never color alone.",
    "Give each terminal on a page its own `ariaLabel` (“Deploy log”, “SSH: web-04”).",
    "Line colors come from tokens that pass contrast on the dark surface — don’t override them with raw ANSI colors."
  ],
  "components": [
    {
      "name": "Terminal",
      "props": [
        {
          "name": "ariaLabel",
          "type": "string",
          "required": false,
          "default": "Terminal output (localized: terminal.output)"
        },
