  "doDont": [
    {
      "do": {
        "caption": "Tone follows meaning, and the word says it too.",
        "example": "<div className=\"flex gap-2\">\n  <Badge tone=\"success\">Active</Badge>\n  <Badge tone=\"warning\">Expiring</Badge>\n  <Badge tone=\"danger\">Failed</Badge>\n</div>"
