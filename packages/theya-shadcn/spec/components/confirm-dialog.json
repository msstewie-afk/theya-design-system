  "name": "ConfirmDialog",
  "file": "ui/confirm-dialog",
  "import": "import { ConfirmDialog } from '@theya/shadcn/ui/confirm-dialog';",
  "status": "stable",
  "category": "Overlays",
  "whenToUse": [
    "High-stakes, irreversible deletes where a click isn’t enough: `confirmValue` makes people type the name.",
    "Deleting a domain, a database, an organisation."
  ],
  "whenNotToUse": [
    {
      "text": "Ordinary confirmations",
      "instead": "AlertDialog"
    },
    {
      "text": "Reversible actions",
      "instead": "UndoToast"
    }
  ],
  "anatomy": [
    {
      "part": "Title and description",
      "description": "the object and what’s lost."
    },
    {
      "part": "Type-to-confirm",
      "description": "`confirmValue`; the action enables only on an exact match.",
      "optional": true
    },
    {
      "part": "Actions",
      "description": "`confirmLabel` with the verb; `tone=\"danger\"`."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Typing the domain makes deleting the wrong one unlikely.",
        "example": "<ConfirmDialog\n  title=\"Delete seashell.dev?\"\n  description=\"All DNS records, mailboxes and certificates for this domain are removed.\"\n  confirmValue=\"seashell.dev\"\n  confirmLabel=\"Delete domain\"\n  tone=\"danger\"\n  trigger={<Button appearance=\"outlined\" tone=\"danger\" size=\"md\">Delete domain</Button>}\n/>"
      },
      "dont": {
        "caption": "Typing a title to archive a draft that can be restored: friction with no protection.",
        "example": "<ConfirmDialog\n  title=\"Archive this draft?\"\n  confirmValue=\"Q3 newsletter draft\"\n  confirmValueMono={false}\n  confirmLabel=\"Archive\"\n  tone=\"neutral\"\n  trigger={<Button appearance=\"outlined\" tone=\"secondary\" size=\"md\">Archive draft</Button>}\n/>"
      }
    }
  ],
  "a11y": [
    "The field says exactly what to type; the action stays disabled until it matches.",
    "If the deleted row held the trigger, focus moves to its nearest surviving ancestor instead of falling to the page."
  ],
