    {
      "text": "No useful suggestions",
      "instead": "TextField"
    }
  ],
  "anatomy": [
    {
      "part": "Input",
      "description": "the value is whatever text is in it."
    },
    {
      "part": "Suggestions",
      "description": "filtered as you type; `note` adds a secondary line; `disableFilter` when the server filters."
    },
    {
      "part": "Empty / loading",
      "description": "`emptyMessage`, `loading` — the typed text is kept either way.",
      "optional": true
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Suggests common hosts, accepts any other.",
        "example": "<div className=\"flex w-64 flex-col gap-2\">\n  <Label htmlFor=\"gl-ac-host\">SMTP host</Label>\n  <Autocomplete id=\"gl-ac-host\" options={HOSTS} placeholder=\"smtp.example.com\" />\n</div>"
      },
      "dont": {
        "caption": "A fixed set of values in a free-text field: a typo like “Prro” instead of “Pro” is saved as the plan.",
        "example": "<div className=\"flex w-64 flex-col gap-2\">\n  <Label htmlFor=\"gl-ac-plan\">Plan</Label>\n  <Autocomplete id=\"gl-ac-plan\" options={[{ value: 'starter', label: 'Starter' }, { value: 'pro', label: 'Pro' }]} placeholder=\"Type a plan\" />\n</div>"
      }
    }
  ],
