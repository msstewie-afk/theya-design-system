{
  "$comment": "Generated by scripts/build-spec.mjs from the component sources — do not edit by hand.",
  "name": "Attachment",
  "file": "ui/attachment",
  "import": "import { Attachment } from '@theya/shadcn/ui/attachment';",
  "status": "stable",
  "category": "Files",
  "whenToUse": [
    "Showing a file that’s already attached: in a message, a ticket, a list of uploads.",
    "Staged files before sending, with `onRemove`; failed ones with `error`."
  ],
  "whenNotToUse": [
    {
      "text": "Picking or replacing a file",
      "instead": "File"
    },
    {
      "text": "Uploading several files by drag and drop",
      "instead": "Dropzone"
    }
  ],
  "anatomy": [
    {
      "part": "Kind icon or preview",
      "description": "from `type` (MIME), or `previewUrl` for images."
    },
    {
      "part": "Name",
      "description": "truncated in the middle so the extension stays visible."
    },
    {
      "part": "Meta",
      "description": "size and kind, or `metaText`; replaced by `error`.",
      "optional": true
    },
    {
      "part": "Remove / actions",
      "description": "`onRemove`, `actions`.",
      "optional": true
    },
    {
      "part": "Variant",
      "description": "`pill` inline, `line` in text, `row` in lists, `card` in grids."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Name, kind and size for each file; the failed one says why, in place.",
        "example": "<div className=\"flex w-80 flex-col gap-2\">\n  <Attachment variant=\"row\" name=\"quarterly-report.pdf\" type=\"application/pdf\" size={248000} onRemove={() => {}} />\n  <Attachment variant=\"row\" name=\"backup.tar.gz\" size={5300000000} error=\"Exceeds the 2 GB upload limit\" onRemove={() => {}} />\n</div>"
      },
      "dont": {
        "caption": "A bare link and a generic error: which file, how big, and what went wrong?",
        "example": "<div className=\"flex w-80 flex-col gap-2 font-body text-body-m\">\n  <Link href=\"#gl-att\" underline>Download attachment</Link>\n  <span className=\"text-[var(--color-text-text-danger)]\">Upload failed</span>\n</div>"
      }
    }
  ],
  "a11y": [
    "The name is the accessible name; size and kind are read as its description.",
    "Remove buttons are named per file (“Remove quarterly-report.pdf”); localize with `removeLabel`.",
    "An error is part of the description, not only red text."
  ],
  "components": [
    {
      "name": "Attachment",
      "props": [
        {
          "name": "name",
          "type": "string",
          "required": true
        },
        {
          "name": "actions",
          "type": "ReactNode",
          "required": false
        },
        {
          "name": "className",
          "type": "string",
          "required": false
        },
        {
          "name": "clickHint",
          "type": "string",
          "required": false,
          "description": "What a click-only row does, e.g. \"Replace file\". Shown in place of the\nmeta line while the row is hovered or keyboard-focused, and read as\nthe click control's description (\"report.pdf, button, Replace file\").\nIgnored with `href` or `error`."
        },
        {
          "name": "error",
          "type": "string",
          "required": false
        },
        {
          "name": "href",
          "type": "string",
          "required": false,
          "description": "Turns the name into a real link, its ::after stretched over the whole surface as the hit target."
        },
        {
          "name": "metaText",
          "type": "ReactNode",
          "required": false,
          "description": "Secondary metadata line, e.g. \"Modified today\". Overridden by `error` when set."
        },
        {
          "name": "mimeLabels",
          "type": "Record<string, string>",
          "required": false,
          "default": "{\n  'image/png': 'PNG image',\n  'image/jpeg': 'JPEG image',\n  'application/pdf': 'PDF',\n  'application/zip': 'ZIP archive',\n  'text/plain': 'Text file',\n  'video/mp4': 'MP4 video',\n}"
        },
        {
          "name": "onClick",
          "type": "(() => void)",
          "required": false
        },
        {
          "name": "onRemove",
          "type": "(() => void)",
          "required": false
        },
        {
          "name": "previewUrl",
          "type": "string",
          "required": false
        },
        {
          "name": "removeLabel",
          "type": "string",
          "required": false,
          "description": "Accessible name for the remove button. Default \"Remove {name}\"."
        },
        {
          "name": "selected",
          "type": "boolean",
          "required": false,
          "default": "false",
          "description": "Marks the file as picked — a ring on top of the hover fill, plus `aria-current` on a link."
        },
        {
          "name": "showKind",
          "type": "boolean",
          "required": false,
          "default": "false"
        },
        {
          "name": "showMeta",
          "type": "boolean",
          "required": false,
          "default": "true"
        },
        {
          "name": "size",
          "type": "number",
          "required": false
        },
        {
          "name": "type",
          "type": "string",
          "required": false
        },
        {
          "name": "variant",
          "type": "\"line\" | \"row\" | \"pill\" | \"card\"",
          "values": [
            "line",
            "row",
            "pill",
            "card"
          ],
          "required": false,
          "default": "pill"
        }
      ]
    },
    {
