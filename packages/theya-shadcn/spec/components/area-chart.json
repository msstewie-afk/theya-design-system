  "doDont": [
    {
      "do": {
        "caption": "Requests over a week — the shape of the volume is the point.",
        "example": "<div className=\"w-full\"><AreaChart data={WEEK} unit=\"k\" height={180} ariaLabel=\"Requests this week, peak 4.8k on Friday.\" /></div>"
