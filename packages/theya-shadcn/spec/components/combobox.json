  "whenToUse": [
    "Picking from a long list people search rather than scroll: regions, users, domains.",
    "`multiple`: several values shown as chips — tags, recipients, labels.",
    "`allowCreate`: a list people can add to (new tag)."
  ],
  "whenNotToUse": [
    {
      "text": "Up to 15 known options",
      "instead": "Select (6–15) or RadioGroup (up to 5)"
    },
    {
      "text": "Free text where suggestions only help",
      "instead": "Autocomplete"
    },
    {
      "text": "Searching content, not choosing a value",
      "instead": "SearchBox (Patterns: Search)"
    }
  ],
  "anatomy": [
    {
      "part": "Input",
      "description": "typing filters the list (label and keywords)."
    },
    {
      "part": "Chips",
      "description": "in `multiple` mode; Backspace removes the last.",
      "optional": true
    },
    {
      "part": "Clear / chevron buttons",
      "description": "`showClear`, `showChevron`.",
      "optional": true
    },
    {
      "part": "List",
      "description": "options, an empty message, a loading state, and the “Create …” row with `allowCreate`."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Many options with long names — people type “frank” instead of scanning.",
        "example": "<div className=\"flex w-64 flex-col gap-2\">\n  <Label htmlFor=\"gl-cbx-region\">Region</Label>\n  <Combobox id=\"gl-cbx-region\" options={REGIONS} placeholder=\"Search regions\" />\n</div>"
      },
      "dont": {
        "caption": "Two options behind a search field — a Select or segmented control is faster.",
        "example": "<div className=\"flex w-64 flex-col gap-2\">\n  <Label htmlFor=\"gl-cbx-sort\">Sort by</Label>\n  <Combobox id=\"gl-cbx-sort\" options={[{ value: 'new', label: 'Newest' }, { value: 'old', label: 'Oldest' }]} placeholder=\"Search\" />\n</div>"
      }
    }
  ],
  "a11y": [
    "Input is a `combobox`; arrows move through options, Enter picks, Escape closes.",
    "Label it with `Label` + `id` or `aria-label` — the placeholder isn’t a label.",
    "Chips are announced with their remove buttons (“Remove EU (Ireland)”)."
