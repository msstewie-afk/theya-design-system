  "anatomy": [
    {
      "part": "Date",
      "description": "a DatePicker."
    },
    {
      "part": "Time",
      "description": "a TimeField; `step` in minutes, `hourCycle` 12/24. Stays empty until a time is actually picked."
    },
    {
      "part": "Value",
      "description": "one `Date`; `onChange`’s second argument says whether the time was set."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Date and time picked separately, in 15-minute steps; no silent midnight.",
        "example": "<div className=\"flex w-96 max-w-full flex-col gap-2\">\n  <span aria-hidden=\"true\" className=\"font-body text-body-m font-medium text-[var(--color-text-text)]\">\n    Send at\n  </span>\n  <DateTimePicker aria-label=\"Send at\" step={15} />\n</div>"
      },
      "dont": {
        "caption": "One text field for both: format errors, and no idea whether 3:00 is AM or PM.",
        "example": "<TextField label=\"Send at\" placeholder=\"YYYY-MM-DD HH:MM\" widthSize=\"lg\" />"
      }
    }
  ],
  "a11y": [
