      "part": "Send / Stop",
      "description": "one button: Send, or Stop while `busy` (streaming); `submitLabel`/`stopLabel`."
    },
    {
      "part": "Limit",
      "description": "`maxLength` counter with a danger state near the limit.",
      "optional": true
    },
    {
      "part": "Slots",
      "description": "`leading`/`trailing` tools, `attachments`, `mentions`, `commands`.",
      "optional": true
    }
  ],
  "doDont": [
