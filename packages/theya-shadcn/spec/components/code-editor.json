{
  "$comment": "Generated by scripts/build-spec.mjs from the component sources — do not edit by hand.",
  "name": "CodeEditor",
  "file": "ui/code-editor",
  "import": "import { CodeEditor } from '@theya/shadcn/ui/code-editor';",
  "status": "beta",
  "category": "Code",
  "whenToUse": [
    "Editing config, templates, rules or scripts in the product: JSON, HTML, CSS, JS/TS, shell.",
    "Long code shown read-only where line numbers and selection help (`readOnly`)."
  ],
  "whenNotToUse": [
    {
      "text": "A short snippet to read and copy",
      "instead": "CodeBlock"
    },
    {
      "text": "Prose with formatting",
      "instead": "RichTextEditor"
    },
    {
      "text": "Plain multi-line text",
      "instead": "TextArea"
    },
    {
      "text": "Comparing versions",
      "instead": "DiffViewer"
    }
  ],
  "anatomy": [
    {
      "part": "Header",
      "description": "filename / language, with Copy and Clear on the right (`copy`, `clearable`).",
      "optional": true
    },
    {
      "part": "Gutter",
      "description": "line numbers."
    },
    {
      "part": "Editing area",
      "description": "syntax color from `language`; grows between `minHeight` and `maxHeight`, then scrolls."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Language set — brackets, indentation and color help avoid syntax errors.",
        "example": "<div className=\"w-80\"><CodeEditor aria-label=\"Redirect rules\" filename=\"redirects.json\" language=\"json\" defaultValue={'{\\n  \"/old\": \"/new\"\\n}'} minHeight=\"5rem\" /></div>"
      },
      "dont": {
        "caption": "A plain textarea for JSON: no line numbers, Tab leaves the field.",
        "example": "<div className=\"w-80\"><TextArea aria-label=\"Redirect rules\" defaultValue={'{\\n  \"/old\": \"/new\"\\n}'} rows={3} /></div>"
      }
    }
  ],
  "a11y": [
    "Always give an `aria-label` (or a visible label referenced by it) — it names the editing area.",
    "Tab indents inside the editor. To leave with the keyboard press Esc, then Tab — say so near editors in forms.",
    "Validate on save and point to the line in the error message; color alone doesn’t mark a syntax error.",
    "Copy and Clear buttons are named (`copyLabel`, `clearLabel`)."
  ],
  "components": [
    {
      "name": "CodeEditor",
      "props": [
