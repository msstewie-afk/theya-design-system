  "name": "PhoneField",
  "file": "ui/phone-field",
  "import": "import { PhoneField } from '@theya/shadcn/ui/phone-field';",
  "status": "beta",
  "category": "Text Input",
  "whenToUse": [
    "Any phone number: account, 2FA by SMS, contact details."
  ],
  "whenNotToUse": [
    {
      "text": "Other fixed formats",
      "instead": "MaskedInput"
    }
  ],
  "anatomy": [
    {
      "part": "Country picker",
      "description": "flag + code; `preferredCountries` on top."
    },
    {
      "part": "Number",
      "description": "formatted as typed; the country’s example as placeholder."
    },
    {
      "part": "Message",
      "description": "too short / too long for the country, on blur."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "People type the way they know their number; the value comes out as E.164.",
        "example": "<div className=\"w-72\"><PhoneField label=\"Phone\" defaultCountry=\"BG\" /></div>"
      },
      "dont": {
        "caption": "Making people enter your storage format.",
        "example": "<TextField label=\"Phone\" placeholder=\"+359XXXXXXXXX, no spaces\" widthSize=\"md\" />"
      }
    }
  ],
  "a11y": [
    "Pasting “+44…” switches the country by itself — autofill works.",
    "The picker has a search; the selected country is announced with the number field.",
    "Flags are emoji: on Windows they show as two letters."
