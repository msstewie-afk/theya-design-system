{
  "$comment": "Generated by scripts/build-spec.mjs from the component sources — do not edit by hand.",
  "name": "TextArea",
  "file": "ui/textarea",
  "import": "import { TextArea } from '@theya/shadcn/ui/textarea';",
  "status": "stable",
  "category": "Text Input",
  "whenToUse": [
    "Text that can run to several lines: a description, a message, notes, a list one per line."
  ],
  "whenNotToUse": [
    {
      "text": "One short line",
      "instead": "TextField"
    },
    {
      "text": "Code or config",
      "instead": "CodeEditor"
    },
    {
      "text": "A chat-style prompt with send",
      "instead": "PromptArea"
    }
  ],
  "anatomy": [
    {
      "part": "Label",
      "description": "with required * / `optional`."
    },
    {
      "part": "Field",
      "description": "resizable vertically; height shows the expected length."
    },
    {
      "part": "Description / error",
      "description": "limits and format; error replaces the description."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Room that matches the expected text, and the limit up front.",
        "example": "<div className=\"w-72\"><TextArea label=\"Message\" description=\"Up to 500 characters.\" /></div>"
      },
      "dont": {
        "caption": "A one-line field for a paragraph scrolls the text out of sight.",
        "example": "<TextField label=\"Message\" widthSize=\"lg\" />"
      }
    }
  ],
  "a11y": [
    "Label, description and error are linked like TextField’s.",
    "If there’s a limit, show the count as text, not only by stopping input."
  ],
  "components": [
    {
      "name": "TextArea",
      "props": [
        {
          "name": "description",
          "type": "ReactNode",
          "required": false,
          "description": "Helper text below the field. Hidden when `error` is set."
        },
        {
          "name": "error",
          "type": "ReactNode",
          "required": false,
          "description": "Error message shown below the field with a warning icon, and\nswitches the field to its error styling. Pass `true` for error\nstyling with no message, or a string/node for styling + message."
        },
        {
          "name": "heightSize",
          "type": "\"md\" | \"sm\" | null",
          "required": false,
          "default": "md"
        },
        {
          "name": "label",
          "type": "ReactNode",
          "required": false
        },
        {
          "name": "labelPosition",
          "type": "\"top\" | \"left\"",
          "values": [
            "top",
            "left"
          ],
          "required": false,
          "default": "top",
          "description": "'top' (default) stacks label above the field. 'left' puts a fixed 216px label column beside it, matching TextField's horizontal Formfield layout."
        },
        {
          "name": "optional",
          "type": "boolean",
          "required": false,
          "description": "Shows \"(optional)\" after the label. Ignored when `required`."
        },
        {
          "name": "required",
          "type": "boolean",
          "required": false,
          "description": "Shows a small red asterisk after the label."
        },
        {
          "name": "widthSize",
          "type": "\"md\" | \"lg\" | \"sm\" | \"xl\" | \"full\" | null",
          "required": false,
          "default": "full"
        }
      ]
    }
  ],
  "inherits": [
