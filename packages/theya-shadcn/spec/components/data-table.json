{
  "$comment": "Generated by scripts/build-spec.mjs from the component sources — do not edit by hand.",
  "name": "DataTable",
  "file": "ui/data-table",
  "import": "import { DataTable, DataTableColumnHeader } from '@theya/shadcn/ui/data-table';",
  "status": "stable",
  "category": "Data",
  "whenToUse": [
    "Lists of records people scan, sort, filter, select and act on: sites, domains, invoices, users.",
    "Rows that open a detail page (whole-row link) or carry per-row actions."
  ],
  "whenNotToUse": [
    {
      "text": "A handful of static rows",
      "instead": "Table"
    },
    {
      "text": "Details of one object",
      "instead": "DescriptionList"
    },
    {
      "text": "Cards with images or rich content",
      "instead": "a card grid"
    },
    {
      "text": "Hierarchy",
      "instead": "Tree"
    }
  ],
  "anatomy": [
    {
      "part": "Toolbar",
      "description": "filter / search, then bulk actions when rows are selected (`toolbar` + DataTableToolbar).",
      "optional": true
    },
    {
      "part": "Header",
      "description": "sortable column headers (`DataTableColumnHeader`), optional select-all."
    },
    {
      "part": "Rows",
      "description": "one or two lines (`lines`); cells are DataTableCell kinds; `meta.primary` makes the row a link."
    },
    {
      "part": "Row menu",
      "description": "per-row actions pinned right (`rowMenu`), also on right-click with `contextual`.",
      "optional": true
    },
    {
      "part": "Footer",
      "description": "pagination, or infinite scroll with `onLoadMore`.",
      "optional": true
    },
    {
      "part": "Loading / empty",
      "description": "skeleton rows while `loading`; `emptyState` for none or no matches."
    },
    {
      "part": "Phone layout",
      "description": "below 640px rows stack into items (`mobileLayout=\"stack\"`, default; labels from `meta.label`). `paged` keeps the primary column and pages the rest; `scroll` keeps the table, with `meta.pin` columns frozen."
    }
  ],
  "doDont": [
    {
      "do": {
        "caption": "Each column uses its kind: mono for domains, status with a dot, numbers on the right.",
        "example": "<div className=\"w-[26rem]\"><DataTable columns={good} data={SITES} hideFooter ariaLabel=\"Sites\" /></div>"
      },
      "dont": {
        "caption": "Everything as plain text: raw status values, numbers that don’t line up.",
        "example": "<div className=\"w-[26rem]\"><DataTable columns={bad} data={SITES} hideFooter ariaLabel=\"Sites, plain\" /></div>"
      }
    }
  ],
  "a11y": [
    "Name the table with `ariaLabel`; give rows a `getRowLabel` so links, checkboxes and menus say which row they act on.",
    "The whole-row link is a real link on the primary cell; controls in cells stay separately focusable.",
    "Sort state is announced on the column header; selection count is announced in the toolbar.",
    "Set `getRowId` whenever selection is on and the data can change."
  ],
