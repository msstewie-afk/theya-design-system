#!/bin/sh
# Theya quality gate on every commit: cloud agents, terminal, desktop Code tab.
# Enabled once per clone with: git config core.hooksPath .githooks
root="$(git rev-parse --show-toplevel)"
if ! command -v node >/dev/null 2>&1; then
  echo "theya pre-commit: node not found on PATH, quality gate skipped" >&2
  exit 0
fi
exec node "$root/.claude/hooks/gate-stop.mjs" --staged
